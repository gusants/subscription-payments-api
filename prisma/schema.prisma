generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum PlanInterval {
  monthly
  yearly

  @@map("plan_interval")
}

enum PaymentMethod {
  card
  pix
  boleto

  @@map("payment_method")
}

enum SubscriptionStatus {
  incomplete
  active
  past_due
  canceled

  @@map("subscription_status")
}

enum ChargeStatus {
  pending
  paid
  failed
  expired
  uncollectible

  @@map("charge_status")
}

enum PaymentAttemptResult {
  succeeded
  declined

  @@map("payment_attempt_result")
}

model Plan {
  id            String         @id
  name          String
  amountCents   Int            @map("amount_cents")
  interval      PlanInterval
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  subscriptions Subscription[]

  @@map("plans")
}

model Customer {
  id                String         @id
  name              String
  email             String         @unique
  gatewayCustomerId String?        @map("gateway_customer_id")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  subscriptions     Subscription[]

  @@map("customers")
}

model Subscription {
  id                 String             @id
  customerId         String             @map("customer_id")
  planId             String             @map("plan_id")
  paymentMethod      PaymentMethod      @map("payment_method")
  status             SubscriptionStatus @default(incomplete)
  billingAnchor      DateTime           @map("billing_anchor") @db.Timestamptz(3)
  currentPeriodStart DateTime           @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd   DateTime           @map("current_period_end") @db.Timestamptz(3)
  cardToken          String?            @map("card_token")
  canceledAt         DateTime?          @map("canceled_at") @db.Timestamptz(3)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer           Customer           @relation(fields: [customerId], references: [id])
  plan               Plan               @relation(fields: [planId], references: [id])
  charges            Charge[]

  @@index([customerId])
  @@index([status])
  @@index([planId])
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

enum ChargeFailureReason {
  insufficient_funds
  expired_card
  invalid_token

  @@map("charge_failure_reason")
}

model Charge {
  id                  String           @id
  subscriptionId      String           @map("subscription_id")
  amountCents         Int              @map("amount_cents")
  method              PaymentMethod
  status              ChargeStatus     @default(pending)
  gatewayChargeId     String?          @unique @map("gateway_charge_id")
  gatewayAttemptKey   String?          @unique @map("gateway_attempt_key")
  attemptStartedAt    DateTime?        @map("attempt_started_at") @db.Timestamptz(3)
  attemptCount        Int              @default(0) @map("attempt_count")
  nextRetryAt         DateTime?        @map("next_retry_at") @db.Timestamptz(3)
  dueDate             DateTime         @map("due_date") @db.Timestamptz(3)
  periodStart         DateTime         @map("period_start") @db.Timestamptz(3)
  periodEnd           DateTime         @map("period_end") @db.Timestamptz(3)
  paidAt              DateTime?        @map("paid_at") @db.Timestamptz(3)
  expiresAt           DateTime?        @map("expires_at") @db.Timestamptz(3)
  paymentInstructions Json?            @map("payment_instructions")
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  subscription        Subscription     @relation(fields: [subscriptionId], references: [id])
  attempts            PaymentAttempt[]

  @@unique([subscriptionId, periodStart])
  @@index([status, nextRetryAt])
  @@map("charges")
}

model PaymentAttempt {
  id              String               @id
  chargeId        String               @map("charge_id")
  gatewayChargeId String               @unique @map("gateway_charge_id")
  result          PaymentAttemptResult
  failureReason   ChargeFailureReason? @map("failure_reason")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  charge          Charge               @relation(fields: [chargeId], references: [id])

  @@index([chargeId])
  @@map("payment_attempts")
}

enum WebhookEventOutcome {
  applied
  ignored_duplicate_state
  ignored_unknown_charge
  rejected_out_of_order
  requires_refund
  rejected_mismatch

  @@map("webhook_event_outcome")
}

model WebhookEvent {
  id              String               @id
  gatewayEventId  String               @unique @map("gateway_event_id")
  type            String
  gatewayChargeId String?              @map("gateway_charge_id")
  payload         Json
  receivedAt      DateTime             @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt     DateTime?            @map("processed_at") @db.Timestamptz(3)
  outcome         WebhookEventOutcome?

  @@index([gatewayChargeId])
  @@map("webhook_events")
}
